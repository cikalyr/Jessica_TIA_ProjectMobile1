<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="#FFFFFF" android:padding="12dp">
    <ImageView android:id="@+id/imgVocabularyAvatar" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="Vocabulary avatar" android:src="@android:drawable/sym_def_app_icon" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
        <TextView android:id="@+id/txtWord" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hello" android:textColor="#7F263D" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/txtMeaning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Halo" android:textColor="#35252C" android:textSize="16sp" />
        <TextView android:id="@+id/txtExample" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Example" android:textColor="#765D67" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>